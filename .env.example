# Sahayog AI Environment Configuration
# Copy this file to .env and adjust variables as required.

# Environment & Server
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=sahayog_ai_super_secret_jwt_key_change_in_production_min32chars!
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL + PostGIS)
# For Docker Compose:
DATABASE_URL=postgresql+asyncpg://sahayog:sahayog123@db:5432/sahayog_db
# For local dev / testing without Docker:
# DATABASE_URL=sqlite+aiosqlite:///./sahayog.db

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# AI Provider Configuration (anthropic | openai | mock)
# Defaults to mock fallback if key is empty or AI_MODE=demo
AI_MODE=demo
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
AI_CONFIDENCE_THRESHOLD=0.60

# Web Push (VAPID) Settings for Browser Push Notifications
# Generated dummy keys for local development
VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBkr3qBUYIHBQFLXYp5NMPH84
VAPID_PRIVATE_KEY=UUx12A6_03b_BvjY9YxW3pT7bM81-0-u6oF1eB2vW18
VAPID_CLAIM_EMAIL=mailto:support@sahayog.test

# Notification Stub / External Gateway (sparow | twilio | stub)
SMS_GATEWAY_PROVIDER=stub
SMS_GATEWAY_API_KEY=

# Seed Data Configuration
RUN_SEED_ON_STARTUP=True

